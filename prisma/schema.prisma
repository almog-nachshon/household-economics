generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Monthly snapshot of balances and cash flow, entered via the update form.
model Snapshot {
  id             Int      @id @default(autoincrement())
  month          DateTime @unique
  netIncome      Float
  expenses       Float
  emergencyFund  Float
  homeSavings    Float
  kerenOld       Float
  kerenNew       Float
  investments    Float
  loanBalance    Float
  carLoanBalance Float
  createdAt      DateTime @default(now())
}

// A monthly deposit marked as done on the next-month page, with the split used.
model Deposit {
  id          Int      @id @default(autoincrement())
  month       DateTime @unique
  emergency   Float
  home        Float
  investments Float
  createdAt   DateTime @default(now())
}

model Settings {
  id               Int      @id @default(1)
  targetHomePrice  Float
  equityRatio      Float    // share of the price paid from own equity, e.g. 0.3
  targetDate       DateTime
  emergencyTarget  Float
  monthlyInvest    Float    @default(2500) // fixed long-term ETF deposit
  checkingBuffer   Float    @default(2000) // left in the current account each month
  allocations      String   @default("[]") // JSON: [{ticker, name, pct}]
  monthlyIncome    Float    @default(0)    // 0 = use the last snapshot's net income
  savingsGoal      Float    @default(5000) // wanted to put aside every month
  riskProfile      String   @default("balanced")
  arnonaArea        Float   @default(0)  // apartment area, m²
  arnonaRate        Float   @default(0)  // ILS per m² per year (from the municipal bill)
  arnonaDiscountPct Float   @default(0)  // discount %, e.g. 60
  arnonaDiscountSqm Float   @default(0)  // the discount applies to the first N m², e.g. 97
  rentRenewMonth    Int     @default(12) // month the lease renews (1-12)
  birthYear         Int     @default(0)  // legacy; birthDate is used
  birthDate         DateTime? // for pension projections to age 67
}

// A monthly income line in the base budget (salary, Ministry of Defense allowance, ...).
model Income {
  id     Int    @id @default(autoincrement())
  name   String
  amount Float
  month  Int?   // null = every month; 1-12 = once a year in that month (e.g. a January bonus)
}

// A loan. Known payment + balance gives the months left; adding the rate also gives the interest left.
// Without a payment, it is computed from balance, rate and end month (Shpitzer).
model Loan {
  id         Int       @id @default(autoincrement())
  name       String
  domain     String    @default("loans") // "loans" | "car" | "housing"
  balance    Float     // remaining principal today
  payment    Float?    // monthly payment, if known
  annualRate Float     @default(0) // nominal yearly interest, %
  endMonth   DateTime? // last payment month, if known
  cardId     Int?      // charged to this credit card (e.g. a car loan through the card company); null = bank
}

// A fixed monthly expense: a standing order from the account or a recurring card charge.
model Expense {
  id       Int       @id @default(autoincrement())
  name     String
  amount   Float
  kind     String    // "standing" | "credit" | "cash"
  cardId   Int?      // which credit card, when kind = "credit"
  category   String
  startMonth DateTime? // first month it applies (e.g. a rent increase); null = already
  endMonth   DateTime? // last month of an installment plan; null = ongoing
}

// A one-off (variable) purchase, counted against this month's spending limit.
model Spend {
  id       Int      @id @default(autoincrement())
  date     DateTime
  amount   Float
  category String
  note     String   @default("")
}

// What was bought in a monthly investment review, so next month can keep or switch.
model InvestPick {
  id     Int      @id @default(autoincrement())
  month  DateTime
  symbol String
  bucket String
  pct    Float
  amount Float
  units  Float  @default(0) // units bought (fractional for US shares, ounces for metals)
  price  Float  @default(0) // ILS per unit at purchase

  @@unique([month, symbol])
}

// The Claude advisor's plan for one deposit (month = the deposit's month), refreshed daily until the
// final review on the deposit day (lib/advisor.js, lib/invest-run.js).
model AiPlan {
  id        Int      @id @default(autoincrement())
  month     DateTime @unique
  final     Boolean  @default(false)
  metalsPct Float    @default(10)
  summary   String
  picks     String   // JSON: [{symbol, reason}]
  changes   String   // JSON: [{symbol, action: add|hold|reduce|sell, reason}]
  risks     String   // JSON: [string]
  research  String
  model     String
  createdAt DateTime @default(now())
}

// A pension or keren hishtalmut account with its monthly deposits (from the payslip) for projections.
model Fund {
  id               Int       @id @default(autoincrement())
  name             String
  kind             String    // "keren" | "pension"
  balance          Float
  balanceDate      DateTime
  employeeMonthly  Float     @default(0)
  employerMonthly  Float     @default(0)
  severanceMonthly Float     @default(0)
  feeBalancePct    Float     @default(0) // yearly management fee on the balance, %
  feeDepositPct    Float     @default(0) // management fee on each deposit, %
  returnPct        Float     @default(5) // assumed yearly return before fees, %
  liquidDate       DateTime? // keren hishtalmut: when it can be withdrawn tax-free
  forHome          Boolean   @default(false) // counted toward the home down payment once liquid
  track            String    @default("") // investment track, e.g. "מניות"
  policy           String    @default("") // policy / fund number
  joinDate         DateTime?
  seniorityDate    DateTime? // ותק: can be earlier than joinDate when moved from another fund
  employer         String    @default("")
  agent            String    @default("") // the insurance agency on the account (סוכן מיופה כח)
  agentInfo        String    @default("") // its contact details, one per line
  providerRetire   Float     @default(0) // the fund's own projection at retirement (savings)
  providerPension  Float     @default(0) // the fund's own projected monthly pension
  coverage         String    @default("") // insurance cover, one "name: amount" per line
}

// Claude's review of the pension and keren hishtalmut tracks against the market's best (lib/fund-advisor.js).
model FundReview {
  id        Int      @id @default(autoincrement())
  month     DateTime @unique
  summary   String
  funds     String   // JSON: [{fund, current, verdict, best, alternatives, reason}]
  research  String
  createdAt DateTime @default(now())
}

// The latest Interactive Brokers statement (Flex Web Service, lib/ibkr.js): open positions and cash at the end of
// the last trading day. When it exists it is the portfolio, instead of the "קניתי" buys in InvestPick.
model BrokerState {
  id        Int       @id @default(1)
  fetchedAt DateTime? // the last successful sync
  asOf      DateTime? // the statement's last day
  positions String    @default("[]") // JSON: [{symbol, ibSymbol, name, assetClass, currency, units, markPrice, value, cost}]
  cash      String    @default("[]") // JSON: [{currency, amount}]
  rates     String    @default("{}") // JSON: ILS per unit of each currency on the statement's last day
  todayFills Int      @default(0)    // fills from today's Trade Confirmation query applied on top of the statement
  error     String    @default("")   // the last sync's failure, cleared on success
}

// Every IBKR trade seen, so each new one raises a single alert.
model BrokerTrade {
  tradeId    String   @id
  date       DateTime
  symbol     String
  name       String
  assetClass String
  side       String   // BUY | SELL
  units      Float
  price      Float
  currency   String
  money      Float
}

// The account on each synced statement day (ILS): value with cash, and the holdings' profit, for the week's change.
model BrokerDay {
  date   DateTime @id
  value  Float
  profit Float
}

// Each candidate's exact instrument at IBKR (public product search, lib/ibkr.js). Only candidates found here are
// researched and bought, and their names link to that instrument.
model IbkrContract {
  symbol    String   @id // the candidate's symbol in lib/portfolio.js
  conid     Int?     // null = not at IBKR
  ibSymbol  String   @default("")
  exchange  String   @default("")
  currency  String   @default("")
  isin      String   @default("")
  name      String   @default("")
  checkedAt DateTime
}

// An alert shown on the home and invest pages until dismissed (lib/alerts.js).
model Alert {
  id        Int      @id @default(autoincrement())
  key       String   // the same key is not raised again within a week
  kind      String   // trade | stop | target | advisor | cash | enter | exit
  symbol    String   @default("")
  message   String
  href      String   @default("")
  createdAt DateTime @default(now())
  dismissed Boolean  @default(false)

  @@index([key])
}

// A credit card, shown by its last 4 digits, so each fixed expense can say which card pays it.
model Card {
  id    Int    @id @default(autoincrement())
  last4 String
  name  String @default("")
}
