DATABASE_URL="file:./dev.db"
# Generate with: npm run auth:setup -- "your password"
AUTH_PASSWORD_HASH=""
SESSION_SECRET=""
# Optional 2FA: set to turn it on
# TOTP_SECRET=""
# Claude advisor for the monthly investment review (console.anthropic.com)
ANTHROPIC_API_KEY=""
# Optional extra live price source for US stocks and funds (free key at finnhub.io/register)
FINNHUB_API_KEY=""
# Lets the server cron trigger /api/cron/invest on the 10th
CRON_SECRET=""
# Interactive Brokers Flex Web Service (read-only): Performance & Reports > Flex Queries; token limited to the server's IP
IBKR_FLEX_TOKEN=""
IBKR_FLEX_QUERY_ID=""
# Optional: a Trade Confirmation Flex Query (period Today) so a refresh also shows today's fills
IBKR_FLEX_TRADES_QUERY_ID=""
# Optional: the IBKR page for one instrument, {conid} is replaced (default: the IBKR portal quote page)
# IBKR_QUOTE_URL="https://www.interactivebrokers.com/portal/#/quote/{conid}"
